#!/bin/sh

run_node() {
  runtime_node="$1"
  shift
  node_major="$("$runtime_node" -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
  if [ "$node_major" -ge 18 ] 2>/dev/null; then
    if [ "${1:-}" = "--self-test" ]; then
      exec "$runtime_node" --test "$(dirname "$0")/workflow.test.js"
    fi
    exec "$runtime_node" "$(dirname "$0")/workflow.js" "$@"
  fi
}

if command -v node >/dev/null 2>&1; then
  run_node "$(command -v node)" "$@"
fi

for runtime_node in "$HOME"/.cache/codex-runtimes/*/dependencies/node/bin/node; do
  if [ -x "$runtime_node" ]; then
    run_node "$runtime_node" "$@"
  fi
done

echo "workflow: Node.js 18 or newer was not found." >&2
exit 127
