# Copy this file to .env and replace every CHANGE_ME value.

# Self-hosted releases must use an immutable digest. Local builds may retain the
# zed-collaboration:local default and set COLLABORATION_BUILD_LOCAL=true.
COLLABORATION_IMAGE=ghcr.io/zed-industries/collaboration@sha256:CHANGE_ME
COLLABORATION_PREVIOUS_IMAGE=ghcr.io/zed-industries/collaboration@sha256:CHANGE_ME
COLLABORATION_PUBLIC_URL=https://collaboration.example.com
COLLABORATION_HTTP_PORT=8080

POSTGRES_DB=collaboration
POSTGRES_USER=collaboration
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DATABASE_MAX_CONNECTIONS=16

COLLABORATION_OBJECT_REGION=us-east-1
COLLABORATION_OBJECT_BUCKET=collaboration
COLLABORATION_OBJECT_ACCESS_KEY=CHANGE_ME
COLLABORATION_OBJECT_SECRET_KEY=CHANGE_ME
ZED_CLOUD_INTERNAL_API_KEY=CHANGE_ME

ZED_ENVIRONMENT=development
RUST_LOG=collab=info
LOG_JSON=true

# Local-only overlay and optional host ports.
COLLABORATION_BUILD_LOCAL=false
POSTGRES_PORT=5432
REDIS_PORT=6379
OBJECT_STORE_PORT=9000
OBJECT_STORE_CONSOLE_PORT=9001
