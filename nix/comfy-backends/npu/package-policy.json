{
  "schema_version": 1,
  "backend": "npu",
  "allowed_payloads": [
    "LICENSES",
    "abi/symbols-v1.json",
    "adapter-manifest.json",
    "adapter-manifest.sig",
    "ffi-contracts-v1.json",
    "package-coverage.sha256",
    "package-policy.json"
  ],
  "required_payloads": [
    "LICENSES",
    "abi/symbols-v1.json",
    "adapter-manifest.json",
    "adapter-manifest.sig",
    "ffi-contracts-v1.json",
    "package-coverage.sha256",
    "package-policy.json"
  ],
  "forbidden_payloads": ["*.so", "*.so.*", "*.a", "*.h", "*.o"],
  "maximum_file_bytes": 4194304,
  "signature_algorithm": "ed25519",
  "signature_domain": "sim-comfy-npu-package-v1",
  "signature_coverage_excludes": ["adapter-manifest.sig", "package-coverage.sha256"],
  "redistributes_vendor_runtime": false,
  "license_approval_required_for_vendor_runtime": true,
  "runtime_compilation_forbidden": true,
  "certificate_owner": "comfy_runtime::NativeFfiRegistry"
}
