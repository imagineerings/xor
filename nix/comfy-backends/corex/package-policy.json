{
  "schema_version": 1,
  "backend": "corex",
  "abi_floor": "CoreX-IXRT-0.8-ABI-profile",
  "review_state": "blocked-missing-vendor-headers",
  "allowed_targets": ["x86_64-unknown-linux-gnu"],
  "allowed_files": [
    "LICENSES",
    "abi/symbols-v1.json",
    "adapter-manifest.json",
